# Copy to .env and fill in what you have. Everything is optional: without keys the
# platform runs in offline mode (heuristic LLM, stored/sample documents only).

# PostgreSQL: seller accounts, lead stage/owner/notes and configuration (services, ICP, questions, rules, scoring).
# URL-encode special characters in the password (space = %20).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/MT
# MongoDB: companies, collected documents, AI signals, alerts/events, scores, run logs and the LLM cache.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=leadradar

# LLM — "anthropic" or "heuristic"; empty = anthropic when ANTHROPIC_API_KEY is set
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_SMALL_MODEL=claude-haiku-4-5
LLM_EFFORT=medium
LLM_MAX_CONCURRENCY=8

# Data sources — limits and fallback per source: docs/data-sources.md (GIG-14)
NEWSAPI_KEY=
# SerpAPI free tier is ~100-250 searches/month: used only for the SERPAPI_TOP_N best leads
SERPAPI_KEY=
SERPAPI_TOP_N=10
# Discovery sources (all optional; a source without its key is skipped)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
NEWSDATA_KEY=
CURRENTS_KEY=
THEMUSE_KEY=
# SEC EDGAR requires "Name email@domain" as User-Agent; SEC sources are off until set
SEC_USER_AGENT=
# Discovery: markets default (editable in PUT /scoring-config -> discovery_countries)
DISCOVERY_COUNTRIES=RO,MD
DISCOVERY_MAX_ITEMS_PER_SOURCE=200
ENRICH_TOP_N=20
# Background refresh of discovery sources on their catalogue intervals
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=60
USE_PLAYWRIGHT=false
CRAWL_MAX_PAGES=12
CRAWL_DELAY_SECONDS=1.0
# true = skip network collectors and analyse only documents already stored
OFFLINE_COLLECT=false

# CRM (HubSpot private app token with crm.objects.companies.* and notes scopes)
HUBSPOT_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
